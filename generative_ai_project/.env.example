# ═══════════════════════════════════════════════════════════════
# Environment Variables — Fully Open-Source Stack (No API Keys!)
# ═══════════════════════════════════════════════════════════════

# ─── LLM (Unsloth — Local Gemma) ──────────────────────────
MODEL_PROVIDER=unsloth
UNSLOTH_MODEL_ID=
UNSLOTH_MAX_SEQ_LENGTH=8192
UNSLOTH_LOAD_IN_4BIT=true
UNSLOTH_DTYPE=
HF_TOKEN=

# ─── Vector Store (Weaviate) ────────────────────────────────
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_URL=localhost:50051

# ─── Redis (Session Cache) ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── PostgreSQL (Bookings) ─────────────────────────────────
DATABASE_URL=postgresql://orchestrator:orchestrator_dev@localhost:5432/orchestrator

# ─── Observability ──────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─── Application ────────────────────────────────────────────
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_WORKERS=8                            # Thread pool size for concurrent scoring/distance calc
