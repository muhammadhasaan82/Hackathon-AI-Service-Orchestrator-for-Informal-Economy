# ═══════════════════════════════════════════════════════════════
# Environment Variables — Fully Open-Source Stack (No API Keys!)
# ═══════════════════════════════════════════════════════════════

# ─── LLM Backend Selection ────────────────────────────────────
# Choose ONE backend:
#   transformers — HuggingFace transformers (CPU-capable, default fallback)
#   ollama       — Ollama REST API (RECOMMENDED for CPU-only VMs)
#   unsloth      — Unsloth FastLanguageModel (GPU/CUDA REQUIRED)
MODEL_BACKEND=transformers

# Model name for the active backend.
# Each backend interprets this differently:
#   transformers : HuggingFace model id   (e.g., google/gemma-3-4b-it)
#   ollama       : Ollama tag             (e.g., gemma3:4b, gemma2:9b)
#   unsloth      : Unsloth HF model id    (e.g., unsloth/gemma-4-31b-it-bnb-4bit)
MODEL_NAME=gemma3:4b

# ─── Ollama (used when MODEL_BACKEND=ollama) ──────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── Unsloth (used when MODEL_BACKEND=unsloth, GPU only) ──────
# Fine-tuning and high-throughput GPU inference. Leave blank on CPU-only VMs.
UNSLOTH_MAX_SEQ_LENGTH=8192
UNSLOTH_LOAD_IN_4BIT=true
UNSLOTH_DTYPE=

# ─── HuggingFace ──────────────────────────────────────────────
# Required for gated models (Gemma 3 / Gemma 4). Get one at:
#   https://huggingface.co/settings/tokens
HF_TOKEN=

# ─── Vector Store (Weaviate) ──────────────────────────────────
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_URL=localhost:50051

# ─── Redis (Session Cache) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── PostgreSQL (Bookings) ────────────────────────────────────
DATABASE_URL=postgresql://orchestrator:orchestrator_dev@localhost:5432/orchestrator

# ─── Observability ────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─── Application ──────────────────────────────────────────────
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_WORKERS=8                            # Thread pool size for concurrent scoring/distance calc
