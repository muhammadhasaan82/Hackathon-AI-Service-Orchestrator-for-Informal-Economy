# ═══════════════════════════════════════════════════════════════
# AI Service Orchestrator — Open Source Hybrid AI Stack
# Agentic RAG + Prompt Engineering + CAG + Fine-Tuning Pipeline
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# Runtime Backend Selection
# ──────────────────────────────────────────────────────────────
# Available:
#   ollama       → Recommended for CPU-only VMs
#   transformers → Direct HuggingFace inference
#   unsloth      → GPU/CUDA ONLY (fine-tuning or high-perf inference)
MODEL_BACKEND=ollama

# Model name depends on backend:
# ollama       → gemma3:4b
# transformers → google/gemma-3-4b-it
# unsloth      → unsloth/gemma-4-31b-it-bnb-4bit
MODEL_NAME=gemma3:4b

# ──────────────────────────────────────────────────────────────
# Ollama Configuration
# ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ──────────────────────────────────────────────────────────────
# Transformers Backend
# ──────────────────────────────────────────────────────────────
TRANSFORMERS_DEVICE=cpu
TRANSFORMERS_DTYPE=float32

# ──────────────────────────────────────────────────────────────
# Unsloth Configuration (GPU ONLY)
# ──────────────────────────────────────────────────────────────
# Leave unchanged on CPU-only VMs.
UNSLOTH_MAX_SEQ_LENGTH=8192
UNSLOTH_LOAD_IN_4BIT=true
UNSLOTH_DTYPE=

# ──────────────────────────────────────────────────────────────
# HuggingFace
# ──────────────────────────────────────────────────────────────
# Required for gated Gemma models.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# ──────────────────────────────────────────────────────────────
# Embedding Model
# ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=128

# ──────────────────────────────────────────────────────────────
# Vector Store — Weaviate
# ──────────────────────────────────────────────────────────────
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_URL=localhost:50051
WEAVIATE_COLLECTION=ServiceProvider

# ──────────────────────────────────────────────────────────────
# Redis - Session Memory only
# ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# ──────────────────────────────────────────────────────────────
# PostgreSQL — Persistent Storage
# ──────────────────────────────────────────────────────────────
# Docker-mapped host port
DATABASE_URL=postgresql://orchestrator:orchestrator_dev@localhost:5433/orchestrator

# ──────────────────────────────────────────────────────────────
# Agentic RAG Configuration
# ──────────────────────────────────────────────────────────────
TOP_K_RESULTS=5
RERANK_RESULTS=false
ENABLE_LLM_INTENT=true
ENABLE_LLM_RANKING_REASONING=false
ENABLE_LLM_BOOKING_CONFIRMATION=false
ENABLE_LLM_FOLLOWUP_TEXT=false
MAX_OLLAMA_CALLS_PER_REQUEST=1
SIMILARITY_THRESHOLD=0.72

# ──────────────────────────────────────────────────────────────
# Cache-Augmented Generation (CAG)
# ──────────────────────────────────────────────────────────────
ENABLE_CAG=true
CAG_MAX_CONTEXT_ITEMS=20
CAG_MAX_CONTEXT_CHARS=2500
CAG_CACHE_STRATEGY=local_file

# ──────────────────────────────────────────────────────────────
# Prompt Engineering / Agent Runtime
# ──────────────────────────────────────────────────────────────
SYSTEM_LANGUAGE=multilingual
SUPPORTED_LANGUAGES=en,ur,roman_urdu
ENABLE_TOOL_CALLING=true
ENABLE_HUMAN_HANDOFF=true

# ──────────────────────────────────────────────────────────────
# Observability / OpenTelemetry
# ──────────────────────────────────────────────────────────────
ENABLE_TRACING=true
OTEL_SERVICE_NAME=ai-service-orchestrator
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ──────────────────────────────────────────────────────────────
# API Server
# ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
MAX_WORKERS=8

# ──────────────────────────────────────────────────────────────
# Performance / Runtime
# ──────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=120
MAX_CONCURRENT_REQUESTS=50
ENABLE_STREAMING=true

# ──────────────────────────────────────────────────────────────
# Development
# ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
